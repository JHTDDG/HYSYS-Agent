# ============================================================
# AI 化工反应器智能建模 —— 配置文件
# 用法：把本文件复制为 .env（同目录），填入你的 APIKey 后启动服务
#       copy .env.example .env
# 注意：.env 已在 .gitignore 中，密钥不会被提交
# ============================================================

# ---- LLM 解析层（硅基流动 SiliconFlow，OpenAI 兼容接口）----
# 官网：https://siliconflow.cn  控制台获取 API 密钥
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=
# 模型推荐（按效果排序，均可结构化输出）：
#   deepseek-ai/DeepSeek-V3        首选：中文理解与 JSON 输出最稳，化工知识强
#   Qwen/Qwen2.5-72B-Instruct      备选：效果接近，价格稍低
#   Qwen/Qwen2.5-7B-Instruct       免费档：能跑通全流程，解析偶有偏差（有规则引擎兜底）
#   THUDM/glm-4-9b-chat            免费档
# 当前启用：免费档（跑通全流程够用，解析偶有偏差由规则引擎兜底）
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 好模型（演示/答辩时切换回来，取消注释下行并注释掉上行）：
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# ---- HYSYS 适配器 ----
# auto = 检测到本机 HYSYS 则用真实 COM，否则 Mock；com = 强制真实；mock = 强制 Mock
HYSYS_MODE=auto

# 可选：HYSYS 模板模式（在 GUI 手工搭好流程存为 .hsc 后填路径，COM 反应 API 受阻时的兜底）
# HYSYS_TEMPLATE_PATH=

# ---- 服务监听 ----
# 部署到远程工作站供本机浏览器访问时改为 0.0.0.0
HOST=127.0.0.1
PORT=8000
